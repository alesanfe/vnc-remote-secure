# Docker ignore file - excludes unnecessary files from Docker build context

# Version control
.git/
.gitignore
.gitattributes

# IDE
.idea/
.vscode/
.qodo/
.refact/

# Secrets and local config
.env
.env.*
!.env.example
secrets/
*.key
*.pem
*.pfx
*.p12

# SSL certificates
data/ssl/
ssl/

# Logs and runtime
logs/
*.log
*.log.*
.runtime/
run/
*.pid
.runtime_credentials.json
*.runtime_credentials.json

# Node.js (not needed in production image)
node_modules/
package-lock.json
test-results/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.hypothesis/

# Security scan reports (not needed in production image)
bandit-report.json
*.sarif
trivy-report.json
gitleaks-report.json

# Virtual environments
venv/
.venv/
env/

# Build artifacts
dist/
build/
artifacts/

# Binaries (downloaded at runtime, not in image)
bin/
novnc/

# Third-party
third_party/

# Tests (not needed in production image)
tests/
tests/fixtures/

# Documentation (not needed in production image)
docs/
doc/
CHANGELOG.md
CODE_OF_CONDUCT.md
CONTRIBUTING.md
ROADMAP.md

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.swp
*.swo
*~
*.tmp
_commit_msg.txt
