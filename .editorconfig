root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{sh,bash}]
indent_style = tab
indent_size = 4

[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab

[*.{json,toml,ini,cfg}]
indent_style = space
indent_size = 2

[*.html]
indent_style = space
indent_size = 4

[*.{js,css}]
indent_style = space
indent_size = 2
