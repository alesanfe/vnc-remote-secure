# ============================================================================
# ENVIRONMENT VARIABLES EXAMPLE
# ============================================================================
# Copy this file to .env and customize the values for your setup

# ============================================================================
# REQUIRED VARIABLES
# ============================================================================

# Password for the web terminal (ttyd on Linux, Tornado on Windows).
# This is the CANONICAL password variable for terminal/UI authentication.
# `USER_UI_PASSWORD` (below) is a fallback for the Flask user-management UI;
# it is used only when TTYD_PASSWD is empty. TTYD_PASSWD takes precedence.
# `TTYD_PASSWORD` is NOT supported -- always use `TTYD_PASSWD`.
# RECOMMENDED for production: set a strong password (min 8 chars, uppercase, lowercase, digit, special char)
# If not set, a strong random password is generated at startup and persisted
# owner-only to <run_dir>/generated_credentials.env (never printed to console)
TTYD_PASSWD=

# ============================================================================
# OPTIONAL VARIABLES
# ============================================================================

# Username for web terminal authentication (default: current user on Linux, 'admin' on Windows)
# Leave empty to use the OS default; set explicitly for cross-platform consistency
TTYD_USERNAME=

# Temporary user name for remote access (default: remote)
TEMP_USER=remote

# Temporary user password (unset = passwordless account, SSH-key only)
TEMP_USER_PASS=

# Email for SSL certificate (required for Let's Encrypt; must NOT use example.com)
EMAIL=

# ============================================================================
# NETWORK CONFIGURATION
# ============================================================================

# Port for noVNC (default: 6080)
NOVNC_PORT=6080

# Port for the internal WebSocket->RFB bridge (websockify, default:
# 5700). Loopback only — clients reach it through the authenticated
# noVNC server which proxies /websockify after the auth check.
NOVNC_WS_PORT=5700

# Directory containing the noVNC web assets. Defaults to <project>/novnc
# (populated by `make setup-novnc`). The static server refuses to start
# without a valid directory — it never serves the process working dir.
#NOVNC_DIR=

# Port for the web terminal (default: 5000)
TTYD_PORT=5000

# Bind host for the web terminal (default: 127.0.0.1; set to 0.0.0.0 for LAN)
TTYD_HOST=127.0.0.1

# Port for VNC (Linux: 5901 for display :1; Windows: 5900 for UltraVNC)
# Linux: TigerVNC always binds 5900+VNC_DISPLAY regardless of this
# value (the adapter never passes -rfbport) — change VNC_DISPLAY to
# move the port. Windows: honoured as UltraVNC PortNumber.
#VNC_PORT=



# Path to the UltraVNC winvnc.exe binary (Windows only).
# Leave commented to auto-detect from common install locations, or set
# explicitly to override the search order. The Windows installer
# auto-provisions UltraVNC if this is unset and winvnc.exe is not found.
#ULTRAVNC_PATH=

# URL for the UltraVNC portable zip (Windows installer only).
# Leave commented to use the official release. Override only if you
# need to point to a mirror or a specific version.
#ULTRAVNC_URL=

# Python interpreter name used when registering the Windows service
# (fallback when the ProgramData service launcher is absent).
# Leave commented to use 'python' from PATH.
#PYTHON=

# Port for landing page (default: 8000)
LANDING_PORT=8000

# ============================================================================
# NGINX REVERSE PROXY CONFIGURATION (OPTIONAL)
# ============================================================================

# Enable nginx reverse proxy (default: false)
# When enabled, nginx will handle SSL and route traffic to services
# Services will bind to 127.0.0.1 only, improving security
NGINX_ENABLED=false

# Nginx port for HTTP (default: 80)
NGINX_HTTP_PORT=80

# Nginx port for HTTPS (default: 443)
NGINX_HTTPS_PORT=443

# ============================================================================
# SSL/TLS CONFIGURATION
# ============================================================================

# Domain for SSL certificate (required for SSL)
# Example: your-domain.duckdns.org
DUCK_DOMAIN=

# Duck DNS token (required for automatic IP updates)
# Get your token from https://www.duckdns.org/
# This is used by scripts/utilities/duckdns_update.py (make duckdns-update)
# to keep your domain pointing to your IP
DUCKDNS_TOKEN=

# Duck DNS update interval in minutes (default: 5)
# Only used when running duckdns-update as a daemon
DUCKDNS_UPDATE_INTERVAL=5

# ============================================================================
# DISCORD NOTIFICATIONS (OPTIONAL)
# ============================================================================

# Enable Discord notifications (default: false)
DISCORD_ENABLED=false

# Discord webhook URL (required if DISCORD_ENABLED=true)
# Create a webhook in your Discord server settings, e.g.
# https://discord.com/api/webhooks/<id>/<token>
DISCORD_WEBHOOK_URL=

# ============================================================================
# FAIL2BAN CONFIGURATION (OPTIONAL)
# ============================================================================

# Enable Fail2ban protection (default: false)
FAIL2BAN_ENABLED=false

# Maximum retry attempts before ban (default: 5)
FAIL2BAN_MAX_RETRY=5

# Time window for retries in seconds (default: 600 = 10 minutes)
FAIL2BAN_FINDTIME=600

# Ban duration in seconds (default: 3600 = 1 hour)
FAIL2BAN_BANTIME=3600

# ============================================================================
# MONITORING CONFIGURATION (OPTIONAL)
# ============================================================================

# NOTE: MONITORING_ENABLED and PROMETHEUS_PORT / GRAFANA_PORT /
# NODE_EXPORTER_PORT were removed — nothing consumed them after the
# Bash stack removal. The Python monitoring module serves /metrics on
# the health port; external Prometheus/Grafana stacks are unmanaged.

# ============================================================================
# HEALTHCHECK CONFIGURATION
# ============================================================================

# Enable health checks (default: true)
# Drives the service-manager watchdog: dead services are detected and
# alerted (and restarted when AUTO_RESTART=true) while `vnc-remote
# service --run` or `start --foreground` is active.
HEALTHCHECK_ENABLED=true

# Watchdog check interval in seconds (default: 30)
HEALTHCHECK_INTERVAL=30

# Auto-restart failed services via the watchdog (default: false)
AUTO_RESTART=false

# Enable health web server (default: true)
HEALTH_WEB_ENABLED=true

# Health web server port (Linux: 8080; Windows: 8090)
# Leave commented to use the platform-aware default from config/defaults/
#HEALTH_WEB_PORT=8080

# Protocols nginx uses to reach each backend service (default:
# auto-detected — "https" when the services terminate TLS
# themselves via resolved certs, "http" otherwise).
# Only needed to override the auto-detection.
#HEALTH_BACKEND_PROTOCOL=
#NOVNC_BACKEND_PROTOCOL=
#TTYD_BACKEND_PROTOCOL=
#LANDING_BACKEND_PROTOCOL=
#AUDIO_BACKEND_PROTOCOL=
#GAMEPAD_BACKEND_PROTOCOL=

# ============================================================================
# USER MANAGEMENT UI CONFIGURATION (OPTIONAL)
# ============================================================================

# Enable User Management UI (default: false)
USER_UI_ENABLED=false

# User UI port (default: 8081)
USER_UI_PORT=8081

# User UI bind address (default: 127.0.0.1)
USER_UI_HOST=127.0.0.1

# User UI admin username (default: TTYD_USERNAME if set, otherwise the
# current user on Linux / 'admin' on Windows)
#USER_UI_USERNAME=

# User UI admin password (takes precedence over TTYD_PASSWD when set)
# If neither TTYD_PASSWD nor USER_UI_PASSWORD is set, login to the UI is disabled
USER_UI_PASSWORD=

# Flask secret key (auto-generated if not set)
# IMPORTANT: Set a strong random key in production for security
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# ============================================================================
# ALERTS CONFIGURATION (OPTIONAL)
# ============================================================================

# Enable webhook/email alerts (default: false)
ALERTS_ENABLED=false

# Webhook URL for alerts
ALERT_WEBHOOK_URL=

# Email recipient for alerts
ALERT_EMAIL_TO=

# Email sender for alerts (must match the runtime fallback in
# monitoring/alerts.py: vnc-remote-secure@localhost)
ALERT_EMAIL_FROM=vnc-remote-secure@localhost

# SMTP server for email alerts
ALERT_SMTP_SERVER=127.0.0.1:587

# Use STARTTLS for SMTP (protects message body, not just credentials)
ALERT_SMTP_TLS=true

# SMTP username (if authentication required)
ALERT_SMTP_USER=

# SMTP password (if authentication required)
ALERT_SMTP_PASS=

# ============================================================================
# VNC SERVER CONFIGURATION
# ============================================================================

# VNC display number (default: :1)
VNC_DISPLAY=:1

# VNC resolution (default: 1280x720)
VNC_GEOMETRY=1280x720

# VNC color depth (default: 24)
VNC_DEPTH=24

# VNC password (auto-generated if not set)
VNC_PASSWORD=

# ============================================================================
# SSL/TLS CERTIFICATE PATHS
# ============================================================================

# Path to SSL certificate file (PEM format)
# If not set, defaults to <ssl_dir>/fullchain.pem when available —
# the platform ssl dir is /var/lib/vnc-remote-secure/ssl (root),
# ~/.local/share/vnc-remote-secure/ssl (non-root Linux) or
# %ProgramData%\VncRemoteSecure\ssl (Windows).
SSL_CERT=

# Path to SSL private key file (PEM format)
# If not set, defaults to <ssl_dir>/privkey.pem when available.
SSL_KEY=

# ============================================================================
# HOST BIND ADDRESSES
# ============================================================================

# Bind address for the landing page (default: 127.0.0.1; set 0.0.0.0 for LAN)
LANDING_HOST=127.0.0.1

# Bind address for the health dashboard (default: 127.0.0.1; set 0.0.0.0 for LAN)
HEALTH_WEB_HOST=127.0.0.1

# Optional Bearer token for /health endpoints. Empty = open access only
# when every health-serving bind is loopback; any public bind
# (HEALTH_WEB_HOST/USER_UI_HOST/BIND_HOST) fails closed without a token.
HEALTH_AUTH_TOKEN=

# Path to the audit log file (default: the platform log dir —
# /var/log/vnc-remote-secure as root or under systemd, XDG state dir
# otherwise, %ProgramData%\VncRemoteSecure\logs on Windows)
# Consumed by src/vnc_remote_secure/security/audit.py
AUDIT_LOG_FILE=

# Audit log rotation threshold in bytes (default: 10485760 = 10 MB)
AUDIT_LOG_MAX_BYTES=

# Optional second append-only audit sink. Point it at a path on a
# mounted network share or WORM store so tampering with the primary
# log leaves an intact copy. Empty = disabled.
AUDIT_MIRROR_FILE=

# When set, `vnc-remote backup` produces Fernet-encrypted archives
# (.enc.tar.gz); `restore` decrypts automatically. Store it securely.
BACKUP_PASSWORD=

# ============================================================================
# WEB TERMINAL CONFIGURATION
# ============================================================================

# Shell executable for the web terminal (default: /bin/bash on Linux, cmd.exe on Windows)
WEBTERM_SHELL=

# Comma-separated list of allowed LAN IP addresses for terminal access
# If not set, all LAN IPs are allowed (when the service is bound to 0.0.0.0)
ALLOWED_LAN_IPS=

# Public bind host for the nginx reverse proxy (default: 127.0.0.1)
# Set to 0.0.0.0 to expose the portal on the LAN. Backend services stay
# loopback-only (BACKEND_BIND_HOST) — nginx is the only public listener.
# LAN/VPN security profiles set this automatically.
#PUBLIC_BIND_HOST=127.0.0.1

# ============================================================================
# AUTHENTICATION AND SESSIONS
# ============================================================================

# Secret key for JWT/token signing (auto-generated if not set)
AUTH_SECRET=

# Whether to set the Secure flag on session cookies (default: true)
# Set to false only for HTTP-only testing environments
SESSION_COOKIE_SECURE=true

# Flask session cookie name (default: vnc_flask_session)
# Flask's own session cookie (itsdangerous blob holding token/csrf).
# Must differ from 'vnc_session' — that name is reserved for the raw
# HMAC session token the noVNC/terminal/audio services verify.
SESSION_COOKIE_NAME=vnc_flask_session

# Session idle timeout in seconds (default: 1800 = 30 minutes)
# Sliding: activity refreshes the cookie's last_seen claim.
SESSION_IDLE_TIMEOUT=1800

# Maximum session lifetime in seconds (default: 28800 = 8 hours)
SESSION_MAX_LIFETIME=28800

# Whether to trust X-Forwarded-* headers from a reverse proxy (default: false)
# Set to true only when behind a trusted reverse proxy (nginx, etc.)
TRUSTED_PROXY=false

# ============================================================================
# SECURITY PROFILES AND RBAC
# ============================================================================

# Security profile (default: development)
# Options: development, trusted-lan, private-overlay, public-hardened
# Legacy aliases: home-lanâ†’trusted-lan, private-vpnâ†’private-overlay, internet-hardenedâ†’public-hardened, local-onlyâ†’development
# Profiles control bind addresses, TLS requirements, MFA enforcement, etc.
# IMPORTANT: All profiles bind backends to 127.0.0.1; only nginx is public.
SECURITY_PROFILE=development

# Bind host for ALL backend services (default: 127.0.0.1)
# Applies to every service that does not set its own <SERVICE>_HOST.
# NEVER set to 0.0.0.0 -- startup is refused (Zero Trust). To expose a
# single service on the LAN, set its <SERVICE>_HOST=0.0.0.0 instead.
# Only nginx should bind to the public interface (controlled by PUBLIC_BIND_HOST).
BIND_HOST=127.0.0.1

# Allowed origins for WebSocket/CSRF protection (comma-separated)
# Auto-generated from DUCK_DOMAIN if not set; 127.0.0.1 is always allowed
# Example: https://your-domain.duckdns.org,https://your-domain.duckdns.org:443
ALLOWED_ORIGINS=

# ============================================================================
# MFA / TOTP
# ============================================================================

# Require MFA for all logins (default: false)
# When true, users must provide a TOTP code after their password
MFA_REQUIRED=false

# TOTP shared secret (base32, e.g. from QR code provisioning)
# Generate with: python -c "from vnc_remote_secure.security.mfa import generate_totp_secret; print(generate_totp_secret())"
TOTP_SECRET=

# Recovery codes (comma-separated SHA-256 hashes, generated by the system)
# Store safely -- these allow access if TOTP device is lost
RECOVERY_CODES_HASHES=

# ============================================================================
# RATE LIMITING
# ============================================================================

# Max login attempts before lockout (default: 5)
AUTH_MAX_ATTEMPTS=5

# Lockout duration in seconds after max attempts (default: 900 = 15 min)
AUTH_LOCKOUT_SECONDS=900

# Sliding window for counting attempts in seconds (default: 600 = 10 min)
AUTH_WINDOW_SECONDS=600

# ============================================================================
# SESSION SECURITY
# ============================================================================

# SameSite attribute for session cookies (default: Lax)
# Options: Strict, Lax, None
SESSION_SAMESITE=Lax

# ============================================================================
# VNC HTTP PORT (Windows / UltraVNC)
# ============================================================================

# UltraVNC HTTP Java viewer port (default: 5800)
VNC_HTTP_PORT=5800

# ============================================================================
# NOVNC SERVER CONFIGURATION
# ============================================================================

# Bind address for noVNC/websockify (default: 127.0.0.1; set 0.0.0.0 for LAN)
SERVE_NOVNC_HOST=127.0.0.1

# The websockify bridge and the VNC RFB listener always bind loopback —
# the bridge performs no auth of its own and clients reach it only via
# the authenticated /websockify proxy, so no bind override is exposed.

# ============================================================================
# LANDING PAGE AUTHENTICATION (OPTIONAL)
# ============================================================================

# Optional password to protect the landing page itself.
# If empty, a strong random password is generated at first start and
# persisted to <run_dir>/generated_credentials.env (owner-only) — the
# portal is fail-closed and never serves unauthenticated content.
LANDING_PASSWORD=

# ============================================================================
# DEPLOYMENT & RUNTIME
# ============================================================================

# NOTE: VNC_REMOTE_PROFILE is DEPRECATED — it is still consumed as a
# fallback when SECURITY_PROFILE is unset (security/profiles.py
# resolve_profile). Use SECURITY_PROFILE (above) for security profile
# selection; it takes precedence when both are set.
# TLS_ENABLED and DISABLE_SSL are both consumed by the Python runtime
# (src/vnc_remote_secure/security/certificates.py). To disable TLS for
# a single session, prefer `vnc-remote start --no-ssl` or set
# TLS_ENABLED=false (or DISABLE_SSL=true -- both are equivalent).

# DEPRECATED alias for SECURITY_PROFILE (fallback only — see note above).
# Old names are auto-translated: home-lan→trusted-lan,
# private-vpn→private-overlay, internet-hardened→public-hardened,
# local-only→development.
# See config/examples/*.env.example for profile-specific settings
#VNC_REMOTE_PROFILE=

# Enable TLS for the current session (consumed by certificates.py and ssl.sh).
# Default: true (HTTPS/WSS when certificates are configured).
# Set to false to force plain HTTP/WS even if SSL_CERT/SSL_KEY are set.
# Equivalent to DISABLE_SSL=true.
TLS_ENABLED=true

# ============================================================================
# RUNTIME STATE (INTERNAL - DO NOT MODIFY)
# ============================================================================

# Disable SSL flag (automatically set by script, do not modify manually)
DISABLE_SSL=false

# Log directory override for service logs (optional). Leave empty to use
# the canonical platform locations: /var/log/vnc-remote-secure (root),
# $XDG_STATE_HOME/vnc-remote-secure (non-root Linux), or
# %ProgramData%\VncRemoteSecure\logs (Windows). The runtime, cleanup.sh
# and update.sh all honour this variable — a repo-relative ./logs does
# NOT work with installed deployments.
LOG_DIR=

# ============================================================================
# ADVANCED CONFIGURATION (OPTIONAL)
# ============================================================================

# Log level for the Python runtime (services + CLI)
# Levels: DEBUG, INFO, WARN, ERROR, FATAL (WARNING/CRITICAL accepted as aliases) - default: INFO
LOG_LEVEL=INFO

# ============================================================================
# BLUETOOTH / AUDIO / GAMEPAD CONFIGURATION (OPTIONAL)
# ============================================================================
# These features allow sharing Bluetooth devices between client and server:
# - Audio streaming: server audio â†’ client's Bluetooth headphones
# - Gamepad forwarding: client's Bluetooth gamepad â†’ server input

# Enable audio streaming from server to client browser (default: false)
# Requires ffmpeg installed on the server
# Linux:   sudo apt-get install ffmpeg
# Windows: choco install ffmpeg
AUDIO_STREAM_ENABLED=false

# Audio stream WebSocket port (default: 7777)
AUDIO_STREAM_PORT=7777

# Audio stream bind address (default: 127.0.0.1, set 0.0.0.0 for LAN)
AUDIO_STREAM_HOST=127.0.0.1

# Audio capture device (auto-detect if empty)
# Use 'python3 -m vnc_remote_secure.services.audio --list-devices' to list available devices
AUDIO_DEVICE=

# Audio bitrate in kbps (default: 128)
AUDIO_BITRATE=128

# Enable gamepad forwarding from client browser to server (default: false)
# On Linux requires: pip install evdev && sudo modprobe uinput
# On Windows: uses ctypes SendInput (no extra deps)
GAMEPAD_ENABLED=false

# Gamepad WebSocket port (default: 7788)
GAMEPAD_PORT=7788

# Gamepad bind address (default: 127.0.0.1, set 0.0.0.0 for LAN)
GAMEPAD_HOST=127.0.0.1

# Enable verbose output (Python CLI and services, default: false)
VERBOSE=false

# Keep temporary user on exit (default: false)
KEEP_TEMP_USER=false

# ============================================================================
# BACKEND BIND HOST (Security Profile Override)
# ============================================================================
# Forces all backend services to bind to this address, overriding
# individual *_HOST settings. Set by hardened profiles (public-hardened,
# private-overlay) to 127.0.0.1 so backends are not exposed externally.
# Leave empty to use individual service host settings.
BACKEND_BIND_HOST=

# ============================================================================
# NOVNC HOST (DEPRECATED ALIAS)
# ============================================================================
# DEPRECATED: Use SERVE_NOVNC_HOST above. This is retained only as a legacy
# fallback when SERVE_NOVNC_HOST is unset. Do not rely on this in new setups.
#NOVNC_HOST=127.0.0.1

# ============================================================================
# SECURITY HEADERS
# ============================================================================
# Content Security Policy (default: restrictive)
CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self'

# HSTS header value (sent only when TLS is enabled; default:
# max-age=31536000; includeSubDomains). Override only if you know why.
#HSTS_HEADER=

# ============================================================================
# TLS CIPHERS
# ============================================================================
# OpenSSL cipher string (default: modern)
SSL_CIPHERS=TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256

# ============================================================================
# SHARED STATE BACKEND (MULTI-WORKER DEPLOYMENTS)
# ============================================================================
# Backend for shared state (rate limiter, WebSocket revocation, audit
# chain, step-up auth times). The platform default is "sqlite" because
# every service runs as its own process — "memory" is only correct for
# single-process test/dev scenarios.
#SHARED_STATE_BACKEND=sqlite

# Path for the SQLite shared-state database (only used when
# SHARED_STATE_BACKEND=sqlite). Defaults to <run_dir>/shared_state.db.
#SHARED_STATE_DB_PATH=
