# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Shell scripts always use LF
*.sh text eol=lf
*.bash text eol=lf

# PowerShell scripts use CRLF (Windows native)
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Python files always use LF
*.py text eol=lf

# Web files always use LF
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf

# Config files always use LF
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# Markdown files
*.md text eol=lf

# Makefile uses tabs
Makefile text eol=lf

# Systemd units
*.service text eol=lf

# Binary files (never normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.exe binary
*.dll binary
*.so binary
*.bin binary
*.zip binary
*.tar.gz binary
*.pem binary
*.key binary
*.crt binary
*.cert binary
*.pfx binary
*.p12 binary
*.oga binary
*.mp3 binary
