# ============================================================
# VNC Remote Secure - .gitignore
# ============================================================

# --- Secrets and local configuration ---
.env
.env.*
!.env.example
.vnc-credentials
.runtime_credentials.json
*.runtime_credentials.json
secrets/
*.key
*.pem
*.pfx
*.p12

# --- SSL certificates (never commit) ---
ssl/
data/ssl/
# Exception: test certificates in fixtures are safe to commit
!tests/fixtures/certificates/*.pem

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node.js / Playwright ---
node_modules/
test-results/
playwright-report/
.coverage
htmlcov/
*.egg-info/

# --- Virtual environments ---
venv/
.venv/
env/

# --- IDE ---
.idea/
.vscode/
.qodo/
.refact/

# --- Logs and runtime ---
logs/
*.log
*.log.*
data/logs/
data/vnc/
.runtime/
run/
recordings/
*.pid

# --- Backups ---
backups/
backup_*.tar.gz

# --- Build artifacts ---
dist/
build/
artifacts/

# --- Temporary files ---
*.swp
*.swo
*~
*.tmp

# --- System files ---
.DS_Store
Thumbs.db
desktop.ini

# --- noVNC (cloned at runtime, not vendored) ---
novnc/

# --- Old directories (replaced by docs/ and packaging/docker/) ---
doc/
docker/
systemd/

# --- Old root-level Python wrappers (moved to src/vnc_remote_secure/) ---
audio_stream_server.py
config_loader.py
d3des.py
gamepad_server.py
gen_ssl.py
gen_vnc_pass.py
landing_page.py
serve_novnc.py
verify_all.py
web_terminal.py

# --- Old root-level launchers (replaced by vnc-remote CLI) ---
kill_all.sh
launch_nossl.sh

# --- Old duplicate scripts in scripts/ root (moved to subdirectories) ---
scripts/backup.sh
scripts/cleanup.sh
scripts/duckdns_update.py
scripts/duckdns_update.sh
scripts/health-check.sh
scripts/install_systemd.sh
scripts/Manage-Firewall.ps1
scripts/restore.sh
scripts/uninstall.sh
scripts/update.sh

# --- Binaries (managed externally, not committed) ---
bin/
bin/ultravnc/
bin/ttyd_msvc/
bin/*.zip
bin/*.exe
# Exception: native launcher scripts are source code, not downloaded binaries
!native/linux/bin/
!native/linux/bin/*

# --- Third-party cache ---
third_party/cache/
vendor/bin/

# --- Diagnostic / temp test files ---
debug_*.py
debug_*.sh
check_*.py
check_*.sh
free_ports.sh
test_ttyd_*.py
test_ttyd_*.sh
test_vnc_*.py
test_webterm*.py
test_final.py
test_health_json.py
health_*.log
landing_*.log
ttyd_*.log
webterm_*.log
_verify_syntax.sh
_run_tests.sh
_test_pw.sh
