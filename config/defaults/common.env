# VNC Remote Secure - Common defaults (shared across platforms)
VNC_DISPLAY=1
VNC_GEOMETRY=1280x720
VNC_DEPTH=24
VNC_PORT=5900
NOVNC_PORT=6080
TTYD_PORT=5000
HEALTH_WEB_PORT=8090
LANDING_PORT=8000
HEALTHCHECK_ENABLED=true
KEEP_TEMP_USER=false
ENABLE_RECORDING=false
ENABLE_AUDIO=false
ENABLE_GAMEPAD=false
ENABLE_USER_UI=false
WEBTERM_SHELL=bash
