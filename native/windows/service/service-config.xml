<?xml version="1.0" encoding="UTF-8"?>
<!--
  VNC Remote Secure - Windows Service Configuration

  This file defines the configuration for the Windows Service wrapper
  that manages VNC Remote Secure as a background service.

  The service is installed via sc.exe or New-Service and runs the
  Python CLI in service mode.
-->
<service>
  <name>vnc-remote-secure</name>
  <displayName>VNC Remote Secure</displayName>
  <description>Secure browser-based remote access via VNC and web terminal.</description>
  <executable>python</executable>
  <arguments>-m vnc_remote_secure service --run</arguments>
  <workingDirectory>%ProgramData%\VncRemoteSecure</workingDirectory>
  <logPath>%ProgramData%\VncRemoteSecure\logs</logPath>
  <startType>Automatic</startType>
  <errorControl>Normal</errorControl>
  <serviceDependencies>
    <dependency>Tcpip</dependency>
    <dependency>Dnscache</dependency>
  </serviceDependencies>
  <environment>
    <variable name="PYTHONUNBUFFERED" value="1" />
    <variable name="PYTHONPATH" value="%ProgramFiles%\VncRemoteSecure\src" />
  </environment>
  <recoveryActions>
    <action type="Restart" delay="5000" />
    <action type="Restart" delay="10000" />
    <action type="Restart" delay="30000" />
  </recoveryActions>
</service>
