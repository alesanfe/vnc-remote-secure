# VNC Remote Secure - Common defaults (shared across platforms)
# Platform-specific ports (VNC_PORT, HEALTH_WEB_PORT) are in
# config/defaults/linux.env and config/defaults/windows.env.
VNC_DISPLAY=:1
VNC_GEOMETRY=1280x720
VNC_DEPTH=24
NOVNC_PORT=6080
NOVNC_WS_PORT=5700
TTYD_PORT=5000
LANDING_PORT=8000
HEALTHCHECK_ENABLED=true
KEEP_TEMP_USER=false
AUDIO_STREAM_ENABLED=false
AUDIO_STREAM_PORT=7777
GAMEPAD_ENABLED=false
GAMEPAD_PORT=7788
USER_UI_ENABLED=false
USER_UI_PORT=8081
# Every service is a separate process (service_manager spawns one per
# service), so shared state — rate limits, WebSocket revocation, audit
# chain, step-up auth times — MUST live in the SQLite backend or each
# process sees its own empty copy. 'memory' is only correct for
# single-process test/dev scenarios.
SHARED_STATE_BACKEND=sqlite
