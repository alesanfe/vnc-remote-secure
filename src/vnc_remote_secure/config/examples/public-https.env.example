# Public HTTPS profile - TLS with Let's Encrypt
# All services stay on loopback: nginx is the only public listener
# (Zero Trust). Binding LANDING_HOST=0.0.0.0 would expose the portal
# over plain HTTP on :8000, bypassing nginx TLS.
# NOTE: on Windows there is no nginx — the landing portal IS the
# public gateway, so LANDING_HOST must be PUBLIC_BIND_HOST (0.0.0.0)
# or the VPN/LAN interface address; 127.0.0.1 would make the portal
# unreachable remotely.
SECURITY_PROFILE=public-hardened
TLS_ENABLED=true
DUCK_DOMAIN=myremote.duckdns.org
DUCKDNS_TOKEN=your-token-here
LANDING_HOST=127.0.0.1
HEALTH_WEB_HOST=127.0.0.1
