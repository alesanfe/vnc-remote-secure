# VPN profile - TLS with self-signed cert, VPN-only access
#
# private-overlay locks every backend to loopback (LANDING_HOST and
# HEALTH_WEB_HOST included): nginx is the only public listener and
# binds PUBLIC_BIND_HOST=0.0.0.0. VPN-only access is enforced at the
# edge — restrict inbound traffic to the VPN interface/subnet via
# firewall rules or an nginx `allow`/`deny` block, not per-service
# binds (those locks cannot be overridden).
SECURITY_PROFILE=private-overlay
TLS_ENABLED=true
# HEALTH_AUTH_TOKEN is not strictly required (health binds loopback),
# but set one anyway — it also gates /metrics and /audit.
HEALTH_AUTH_TOKEN=change-me-strong-token
