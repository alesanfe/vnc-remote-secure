[Unit]
Description=VNC Remote Secure - Health Monitoring Web Server
Documentation=https://github.com/alesanfe/vnc-remote-secure
After=network.target vnc-remote-vnc.service vnc-remote-novnc.service vnc-remote-ttyd.service

[Service]
Type=simple
User=__TEMP_USER__
Group=__TEMP_USER__
EnvironmentFile=-/etc/vnc-remote/secrets/vnc.env
WorkingDirectory=__PROJECT_DIR__
ExecStart=/usr/bin/python3 __PROJECT_DIR__/src/lib/monitoring/health_web_server.py
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp
RestrictSUIDSGID=true
LockPersonality=true
# Health server needs to check other services on localhost
IPAddressDeny=any
IPAddressAllow=127.0.0.1

[Install]
WantedBy=multi-user.target
