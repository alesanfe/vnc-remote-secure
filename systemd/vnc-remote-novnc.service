[Unit]
Description=VNC Remote Secure - noVNC WebSocket Proxy
Documentation=https://github.com/alesanfe/vnc-remote-secure
After=vnc-remote-vnc.service
Requires=vnc-remote-vnc.service

[Service]
Type=simple
User=__TEMP_USER__
Group=__TEMP_USER__
EnvironmentFile=-/etc/vnc-remote/secrets/vnc.env
ExecStart=/usr/bin/python3 -m websockify --web /usr/share/novnc --vnc 127.0.0.1:__VNC_PORT__ --listen 127.0.0.1:__NOVNC_PORT__
Restart=on-failure
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
LockPersonality=true
# noVNC only needs network access to localhost VNC
IPAddressDeny=any
IPAddressAllow=127.0.0.1

[Install]
WantedBy=multi-user.target
